---
/**
 * The opening card: the nav, the promise and the downloads set in ink on
 * the light band of the ember painting, and the app's window lower down on
 * the same painting, its top showing at the foot of the first screen.
 *
 * The painting opens full-screen, but the words and the window are laid
 * out in the page's column from the start. The painting stays full-screen
 * while the window rises to the middle of the screen; scrolling on, the
 * wall closes in to that column, the edges every panel below shares. The
 * painting drifts behind the window all the while. `site.css` draws the
 * frame; the script in `Page.astro` scrubs it with the scroll.
 */
import type { Copy, Lang } from '../content/copy'
import { introSizes, paintings } from '../content/paintings'
import { screens } from '../content/screens'
import Nav from './Nav.astro'
import Painting from './Painting.astro'
import Phrases from './Phrases.astro'
import Shot from './Shot.astro'

interface Props {
  copy: Copy
  lang: Lang
}

const { copy, lang } = Astro.props
const h = copy.hero
---

<header class="intro" id="top">
  <div class="intro__card" data-intro>
    <Painting painting={paintings.intro} phone={paintings.heroPhone} sizes={introSizes} eager />
    <div class="intro__hero wrap">
      <Nav copy={copy} lang={lang} />
      <div class="hero__copy">
        <h1 class="hero__title" style="--i: 0"><Phrases text={h.title} /></h1>
        <p class="hero__lede" style="--i: 1"><Phrases text={h.lede} /></p>
        <div class="hero__actions" style="--i: 2">
          <a class="button button--ink" href="#download">{h.primary}</a>
          <a class="button button--line" href="#download">{h.secondary}</a>
          <a class="text-link" href="#demo">{h.demo}</a>
        </div>
        <p class="hero__note" style="--i: 3">{h.note}</p>
      </div>
    </div>
    <div class="wrap">
      <Shot class="intro__shot" copy={copy} lang={lang} screens={[screens.browsing, screens.agent]} openOn="browsing" tabs eager />
    </div>
  </div>
</header>
<p class="caption wrap intro__caption">{copy.shot.caption}</p>
