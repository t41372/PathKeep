# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# Leftover local coverage and mutation reports from the retired gates.
coverage
**/mutants.out*/
target-llvmcov
# Downloaded AI model weights / caches for the env-gated candle/static tests (W-AI-4b/4c). Large
# (candle ~1.2 GB, static potion ~512 MB), reproducible by re-download (SHA-256 pinned), never
# committed. Anywhere under the repo (the integration test resolves its cache relative to its CWD).
artifacts/candle-models/
artifacts/static-models/
src-tauri/artifacts/
**/candle-models/
**/static-models/
playwright-report
# E2E run artifacts (HTML report, results.json, traces). See artifacts/e2e/README.md.
artifacts/e2e/*
!artifacts/e2e/README.md
.playwright-mcp
.playwright-cli
reports
test-results
var
output
*.local
reference

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated by Cargo
# will have compiled files and executables
debug
target
# Target-specific Tauri sidecars are reproducible Cargo build outputs.
src-tauri/binaries/pathkeep-worker-*

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Local agent worktrees and runtime metadata
.claude/
